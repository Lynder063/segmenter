<Application x:Class="Segmenter.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Custom Theme overrides for premium dark segment colors -->
            <SolidColorBrush x:Key="SegmentIntroBrush" Color="#007aff"/>
            <SolidColorBrush x:Key="SegmentRecapBrush" Color="#ff9500"/>
            <SolidColorBrush x:Key="SegmentCreditsBrush" Color="#34c759"/>
            <SolidColorBrush x:Key="SegmentPreviewBrush" Color="#ff2d55"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
