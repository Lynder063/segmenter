# Copy this file to .env (git-ignored) and fill in your own values.
# CMake reads .env at configure time — see core/CMakeLists.txt — so changing
# it means re-running cmake, not just rebuilding.

# Discord Rich Presence application ID.
#
# Create one at https://discord.com/developers/applications, then upload Rich
# Presence art assets named exactly "segmenter_logo" under Rich Presence >
# Art Assets — DiscordRpcService.cpp references that key by name.
#
# Leave unset (or leave this file absent) to build without Discord Rich
# Presence — the app runs the same either way, it just never connects to
# Discord's local IPC socket.
DISCORD_CLIENT_ID=
